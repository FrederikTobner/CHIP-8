{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "BUILD_TESTING": "ON"
            }
        },
        {
            "name": "sanitizers",
            "description": "Address sanitizer (including the leak sanitizer on Linux) and undefined behavior sanitizer, GCC and Clang only",
            "hidden": true,
            "cacheVariables": {
                "CP8_ENABLE_SANITIZERS": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "asan-debug",
            "displayName": "Debug with sanitizers",
            "inherits": [
                "debug",
                "sanitizers"
            ]
        },
        {
            "name": "asan-release",
            "displayName": "Release with sanitizers",
            "inherits": [
                "release",
                "sanitizers"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "asan-debug",
            "configurePreset": "asan-debug"
        },
        {
            "name": "asan-release",
            "configurePreset": "asan-release"
        }
    ],
    "testPresets": [
        {
            "name": "base",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            },
            "environment": {
                "SDL_VIDEODRIVER": "dummy",
                "SDL_AUDIODRIVER": "dummy"
            }
        },
        {
            "name": "sanitizers",
            "hidden": true,
            "environment": {
                "ASAN_OPTIONS": "halt_on_error=1:strict_string_checks=1",
                "UBSAN_OPTIONS": "print_stacktrace=1"
            }
        },
        {
            "name": "debug",
            "inherits": "base",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "inherits": "base",
            "configurePreset": "release"
        },
        {
            "name": "asan-debug",
            "inherits": [
                "base",
                "sanitizers"
            ],
            "configurePreset": "asan-debug"
        },
        {
            "name": "asan-release",
            "inherits": [
                "base",
                "sanitizers"
            ],
            "configurePreset": "asan-release"
        }
    ]
}
